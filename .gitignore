# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editors ───────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# ─── Go ────────────────────────────────────────────────────
# 컴파일 산출물과 테스트 바이너리. 의존성은 module cache에 있으므로
# vendor/는 쓰지 않는다 — 쓰게 되면 그때 커밋 여부를 정한다.
/apps/server/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# 커버리지 프로파일
*.out
coverage.*
*.coverprofile
profile.cov

# go.work는 커밋하지 않는다. 로컬에서 여러 모듈을 엮는 개인 설정이다.
go.work
go.work.sum

# ─── Node / Web ────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.pnpm-store/
*.tsbuildinfo

# ─── Terraform ─────────────────────────────────────────────
# state에는 DB 비밀번호와 인스턴스 주소가 평문으로 들어간다. 퍼블릭 레포다.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ─── 엔진 ──────────────────────────────────────────────────
# USI 엔진 바이너리와 NNUE 평가 파일. 용량이 크고 배포 시 이미지에서 받는다.
/engine/bin/
*.nnue

# ─── Secrets ───────────────────────────────────────────────
# OrcaRouter 키, Google OAuth 시크릿, DB 접속 정보가 여기 들어간다.
.env
.env.*
!.env.example
