# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editors ───────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# ─── Go ────────────────────────────────────────────────────
# 컴파일 산출물과 테스트 바이너리. 의존성은 module cache에 있으므로
# vendor/는 쓰지 않는다 — 쓰게 되면 그때 커밋 여부를 정한다.
/apps/server/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# 커버리지 프로파일
*.out
coverage.*
*.coverprofile
profile.cov

# go.work는 커밋하지 않는다. 로컬에서 여러 모듈을 엮는 개인 설정이다.
go.work
go.work.sum

# ─── Node / Web ────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.pnpm-store/
*.tsbuildinfo

# ─── Terraform ─────────────────────────────────────────────
# state에는 DB 비밀번호와 인스턴스 주소가 평문으로 들어간다. 퍼블릭 레포다.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ─── 엔진 ──────────────────────────────────────────────────
# USI 엔진 바이너리와 NNUE 평가 파일. 용량이 크고 배포 시 이미지에서 받는다.
/engine/bin/
*.nnue

# ─── 워크트리 ──────────────────────────────────────────────
# 병렬 워크트리의 브리핑 파일. 그 워크트리 하나에만 해당하는 내용이라
# 브랜치를 타고 main으로 가면 안 된다 (CLAUDE.md 「워크트리」).
/WORKTREE.md

# ─── Secrets ───────────────────────────────────────────────
# Google OAuth 시크릿과 DB 접속 정보가 여기 들어간다.
.env
.env.*
!.env.example

# floodgate 기보 — 남의 대국 기록이고 5MB 넘는다. 받는 절차는 apps/server/README.md
apps/server/internal/kifu/testdata/floodgate/

# 판독을 재는 그림과 그 라벨 — 앱 화면과 방송 캡처는 남의 것이다. 위와 같은 규약이고,
# 넣는 절차는 apps/server/README.md
#
# **폴더 자체는 남긴다.** compose 가 여기를 볼륨으로 붙이므로, 없으면 도커가 root 소유로
# 만들고 그 뒤로 서버가 못 쓴다 — 새로 클론한 사람이 만나는 고장이다
apps/server/internal/boardread/testdata/images/*
!apps/server/internal/boardread/testdata/images/.gitkeep

# `go build ./cmd/importkifu` 가 떨어뜨리는 14MB 바이너리
apps/server/importkifu
apps/server/internal/kifu/testdata/import10/

# 로컬 헬퍼. Claude 가 자기 권한 파일을 못 고치므로(분류기) 규칙을 여기 적어 두고
# 사람이 한 번 돌린다. settings.local.json 과 같은 성질이라 커밋하지 않는다
.claude/how.sh
