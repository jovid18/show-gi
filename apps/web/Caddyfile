# 정적 파일 서빙 + API/WS 프록시. **TLS는 여기서 안 한다.**
#
# 앞단 ALB가 ACM 인증서로 TLS를 끝낸다. Fargate는 로컬 디스크가 휘발성이라
# Caddy가 받아둔 인증서가 배포마다 사라지고, 재발급을 반복하면 Let's Encrypt의
# 주당 실패 한도에 걸려 사이트가 평문으로 떨어진다. 인증서 보관은 AWS가 맡는 편이 낫다.

:80 {
	encode gzip zstd

	header {
		# ALB가 TLS를 끝내므로 여기서 나가는 응답에 붙여야 브라우저에 도달한다
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 이 앱은 iframe에 들어갈 일이 없다. 부정행위용 오버레이를 구조적으로 막는 것이기도 하다
		X-Frame-Options DENY
		-Server
	}

	# 같은 태스크의 컨테이너라 네트워크 네임스페이스를 공유한다 — localhost로 닿는다.
	# 대국은 WebSocket 하나로 오래 열려 있는데, Caddy는 업그레이드와 유휴 타임아웃을
	# 알아서 처리한다. ALB 쪽 타임아웃은 idle_timeout으로 따로 올려뒀다.
	handle /ws* {
		reverse_proxy localhost:8080
	}

	handle /api/* {
		reverse_proxy localhost:8080
	}

	# ALB 헬스체크가 여기를 본다. **api까지 닿는 경로**여야 한다 —
	# Caddy만 살아 있고 api가 죽은 상태를 정상으로 보면 배포가 성공한 척하고 끝난다
	handle /healthz {
		reverse_proxy localhost:8080
	}

	# 나머지는 SPA. 새로고침으로 깊은 경로에 들어와도 index.html로 떨어뜨린다.
	handle {
		root * /srv

		# 파일명에 해시가 박혀 있다(Vite). 내용이 바뀌면 이름이 바뀌므로 영원히 캐시해도
		# 낡을 수가 없다.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# 아이콘은 이름이 고정이라 영원히는 못 건다. 일주일이면 로고를 갈아 끼운 날
		# 다음 배포까지 기다리지 않아도 된다.
		@brand path /favicon.ico /apple-touch-icon.png /icon-*.png /logo-*.png /og.png
		header @brand Cache-Control "public, max-age=604800"

		# Go의 mime 표에 `.webmanifest` 가 없어 `text/plain` 으로 나가고, 그러면 크롬이
		# 매니페스트를 통째로 무시한다 — 홈 화면에 추가했을 때만 드러나는 실패다.
		@manifest path /site.webmanifest
		header @manifest {
			Content-Type "application/manifest+json"
			Cache-Control "public, max-age=604800"
		}

		# **index.html 은 캐시하지 않는다.** 여기에 해시 파일명이 적혀 있어서, 이 문서가
		# 캐시에 남으면 다음 배포에서 지워진 파일을 가리키고 화면이 통째로 안 뜬다.
		# 깊은 주소도 전부 이 문서로 떨어지므로 조건이 「해시도 아이콘도 아닌 것」이다.
		@page not path /assets/* /favicon.ico /apple-touch-icon.png /icon-*.png /logo-*.png /og.png /site.webmanifest
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
