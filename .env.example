# **로컬 개발용이다.** 복사해서 쓴다:  cp .env.example .env
#
# 배포에서는 이 파일을 쓰지 않는다. 값은 SSM Parameter Store(`/show-gi/prod/*`)에
# 있고 `deploy/env.sh`가 셸로 내보낸다 — 서버 디스크에 비밀을 평문으로 두지 않기 위해서다.
#
# .env는 커밋되지 않는다 (.gitignore). 이 레포는 퍼블릭이다.

# ─── 배포 ──────────────────────────────────────────────────
# 이미지를 받아올 ECR. `terraform output ecr_registry`
REGISTRY=058264445568.dkr.ecr.ap-northeast-1.amazonaws.com
# 띄울 이미지 태그. 비우면 latest. 특정 커밋으로 되돌릴 때 SHA를 넣는다
IMAGE_TAG=latest

# Caddy가 이 이름으로 인증서를 발급받는다. DNS가 이 서버를 가리키고 있어야 한다.
SITE_ADDRESS=show-gi.com
# 인증서 만료·발급 실패 알림이 오는 주소. Let's Encrypt가 요구한다
ACME_EMAIL=

# ─── LLM ───────────────────────────────────────────────────
# OrcaRouter. 비우면 개입 설명이 템플릿으로만 나가고 나머지는 정상 동작한다
ORCA_API_KEY=
ORCA_BASE_URL=https://api.orcarouter.ai/v1

# ─── 인증 ──────────────────────────────────────────────────
# Google OAuth. redirect URI는 https://<SITE_ADDRESS>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 쿠키 서명 키. openssl rand -base64 32
SESSION_SECRET=

# ─── DB ────────────────────────────────────────────────────
# 로컬은 비워두면 'showgi'가 쓰인다. 배포에서는 Parameter Store의 값이 들어간다
POSTGRES_PASSWORD=

# ─── 엔진 ──────────────────────────────────────────────────
# 나중에 YaneuraOu로 갈아탈 때 여기만 바꾼다
ENGINE_CMD=fairy-stockfish
