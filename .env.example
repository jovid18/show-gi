# **로컬 개발 전용이다.** 복사해서 쓴다:  cp .env.example .env
#
# 배포에는 이 파일이 관여하지 않는다. 값은 SSM Parameter Store(`/show-gi/prod/*`)에
# 있고, ECS 태스크 정의가 컨테이너에 직접 주입한다 — 어느 디스크에도 남지 않는다.
#
# 전부 비워도 앱은 뜬다. 채운 기능만 켜진다.
#
# .env는 커밋되지 않는다 (.gitignore). 이 레포는 퍼블릭이다.

# ─── LLM ───────────────────────────────────────────────────
# OrcaRouter. 비우면 개입 설명이 템플릿으로만 나가고 나머지는 정상 동작한다
ORCA_API_KEY=
ORCA_BASE_URL=https://api.orcarouter.ai/v1

# ─── 인증 ──────────────────────────────────────────────────
# Google OAuth. redirect URI는 https://<SITE_ADDRESS>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 쿠키 서명 키. openssl rand -base64 32
SESSION_SECRET=

# ─── 엔진 ──────────────────────────────────────────────────
# 나중에 YaneuraOu로 갈아탈 때 여기만 바꾼다
ENGINE_CMD=fairy-stockfish
