# **로컬 개발 전용이다.** 복사해서 쓴다:  cp .env.example .env
#
# 배포에는 이 파일이 관여하지 않는다. 값은 SSM Parameter Store(`/show-gi/prod/*`)에
# 있고, ECS 태스크 정의가 컨테이너에 직접 주입한다 — 어느 디스크에도 남지 않는다.
#
# 전부 비워도 앱은 뜬다. 채운 기능만 켜진다.
#
# .env는 커밋되지 않는다 (.gitignore). 이 레포는 퍼블릭이다.

# ─── 인증 ──────────────────────────────────────────────────
# Google OAuth. **셋이 다 있어야 로그인이 켜진다** — 하나라도 비면 표면이 통째로
# 닫히고 지금까지처럼 익명으로 둔다 (games.user_id 가 nullable인 이유).
#
# 콘솔에 등록할 redirect URI 두 개. 한 글자만 달라도 Google이 거부한다:
#   https://show-gi.com/api/auth/google/callback
#   http://localhost:5173/api/auth/google/callback      ← Vite가 /api를 프록시한다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 쿠키 서명 키. openssl rand -base64 32
#
# **이 값을 바꾸면 로그인된 사람이 전부 로그아웃된다.** 세션이 표가 아니라 서명 쿠키라
# 서버에 짝이 없고, 검증이 이 키 하나로 끝나기 때문이다 (internal/auth).
SESSION_SECRET=
# 브라우저가 이 서버를 부르는 주소. **비워 두는 것이 기본이다** — 비면 요청의 Host로
# 되짚고(localhost면 http, 아니면 https) 로컬·프로덕션 둘 다 맞는다.
# 앞단을 하나 더 끼워 Host가 달라질 때만 적는다
PUBLIC_ORIGIN=

# ─── 엔진 ──────────────────────────────────────────────────
# **여기에 ENGINE_CMD 를 적지 않는다.** 엔진 실행 경로는 이미지 내부 구조라 밖에서
# 적어두면 이미지를 바꿀 때 조용히 어긋난다 — 프로덕션에서 실제로 물렸고
# (docs/06-status.md §11) 그래서 태스크 정의와 docker-compose.yml 양쪽에서 뺐다.
#
#   docker compose      이미지의 ENV 를 그대로 쓴다.  /opt/yaneuraou/run
#                                                    /opt/yaneuraou/run-mate  ← 詰み은 별도 바이너리
#   go run ./cmd/api    셸에서 직접 준다.  ENGINE_CMD=... go run ./cmd/api
#
# **이 파일은 compose 의 ${VAR} 보간에만 쓰인다.** 서버는 .env 를 읽지 않으므로
# compose 가 참조하지 않는 이름을 여기 적으면 아무 일도 일어나지 않는다 —
# 한때 `ENGINE_CMD=fairy-stockfish` 가 이 자리에 그렇게 남아 있었다.
