        <mxCell id="10" value="&lt;b&gt;종국된 판&lt;/b&gt;이 사후 해석 큐에 手를 쌓는다" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.4;fillColor=light-dark(#ffffff,#1b1917);strokeColor=light-dark(#cdc1ab,#4a443c);fontColor=light-dark(#26211b,#e6dfd3);fontFamily=Helvetica;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
