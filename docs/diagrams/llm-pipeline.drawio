        <mxCell id="laneA" value="기보 가져오기 — 글자를 옮겨 적는다" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;strokeWidth=1.8;dashed=1;dashPattern=6 4;fillColor=light-dark(#faf7f1,#171614);strokeColor=light-dark(#2f5d45,#6f9b84);fontColor=light-dark(#1f4433,#a9cebb);fontFamily=Helvetica;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1">
