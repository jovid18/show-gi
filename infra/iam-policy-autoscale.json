{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProjectAppAutoScalingInTokyo",
      "Effect": "Allow",
      "Action": ["application-autoscaling:*"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "CreateAppAutoScalingServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ecs.application-autoscaling.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadTokyoDiagnostics",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents",
        "cloudwatch:GetMetricStatistics",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings",
        "sns:ListTopics",
        "dynamodb:DescribeTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "ReadGlobalCostAndInventory",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "pricing:GetProducts",
        "pricing:DescribeServices",
        "iam:ListRoles",
        "iam:ListOpenIDConnectProviders"
      ],
      "Resource": "*"
    }
  ]
}
